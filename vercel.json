{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run buildReact",
  "outputDirectory": "build",
  "headers": [
    {
      "source": "/version.json",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate, max-age=0"
        },
        {
          "key": "Pragma",
          "value": "no-cache"
        },
        {
          "key": "Expires",
          "value": "0"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "^/(about|creator|developer|support|community-guidelines|terms|privacy|faq|create|join|invite|room-ended|login|signup|forgot-password|reset-password|verify-email|confirm-google-signup|profile|myrooms|debug|error|not-found)/?$",
      "destination": "/index.html"
    },
    {
      "source": "^/(watch|join|invite|preflight|myrooms)/[^/]+/?$",
      "destination": "/index.html"
    },
    {
      "source": "^/account(?:/.*)?$",
      "destination": "/index.html"
    }
  ]
}
