# ==============================================================================
# CoWatch Production Environment Configuration Matrix
#
# Classification:
# - Required: Application will not start or perform core functions without this.
# - Optional: Feature-specific or fallback capabilities.
# - Secret: Never expose to clients, logs, or public repositories.
# - Public: Injected into client bundle (VITE_*) or safe for client inspection.
# - Provider-Specific: Bound to third-party infrastructure adapters.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Server Core Configuration
# ------------------------------------------------------------------------------
NODE_ENV=production
PORT=8080
HOST=0.0.0.0
APP_URL=https://cowatch.tv

# Internal boundary secret for health checks and cluster metrics (Required in Prod)
INTERNAL_API_SECRET=your_high_entropy_internal_secret_token

# ------------------------------------------------------------------------------
# 2. Database & Auth (PostgreSQL via Supabase)
# ------------------------------------------------------------------------------
# PostgreSQL connection string with connection pooler (Required)
DATABASE_URL=postgresql://postgres:[PASSWORD]@db.[PROJECT_REF].supabase.co:5432/postgres?pgbouncer=true

# Backend server service-role credentials (Secret, Required)
SUPABASE_URL=https://[PROJECT_REF].supabase.co
SUPABASE_SECRET_KEY=your_supabase_service_role_secret_key

# Frontend client auth credentials (Public, Required in Vercel/client build)
VITE_SUPABASE_URL=https://[PROJECT_REF].supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your_supabase_anon_public_key
VITE_SERVER_HOST=https://api.cowatch.tv

# ------------------------------------------------------------------------------
# 3. Redis Edge & Distributed Coordination (Optional / Fallback)
# ------------------------------------------------------------------------------
REDIS_URL=rediss://default:[PASSWORD]@[ENDPOINT].upstash.io:6379
REDIS_CORE_URL=rediss://default:[PASSWORD]@[ENDPOINT].upstash.io:6379
REDIS_EDGE_URL=rediss://default:[PASSWORD]@[ENDPOINT].upstash.io:6379
REDIS_METRICS_URL=rediss://default:[PASSWORD]@[ENDPOINT].upstash.io:6379

# ------------------------------------------------------------------------------
# 4. Transactional Email & Delivery Profiles (Provider-Agnostic)
# ------------------------------------------------------------------------------
# Default provider adapter: "smtp" | "brevo" | "resend"
EMAIL_PROVIDER=smtp

# Default sender identity
EMAIL_FROM_ADDRESS=noreply@cowatch.tv
EMAIL_FROM_NAME=CoWatch

# Delivery Profile Sender Identity Overrides (Optional, defaults to EMAIL_FROM_ADDRESS)
EMAIL_PROFILE_INVITATION_SENDER="CoWatch Invites <invites@cowatch.tv>"
EMAIL_PROFILE_SECURITY_SENDER="CoWatch Security <security@cowatch.tv>"
EMAIL_PROFILE_SYSTEM_SENDER="CoWatch Updates <updates@cowatch.tv>"

# Delivery Profile Infrastructure Bindings (Maps Profile -> Account Binding Name)
EMAIL_PROFILE_DEFAULT_BINDING=default
EMAIL_PROFILE_INVITATION_BINDING=default
EMAIL_PROFILE_SECURITY_BINDING=default
EMAIL_PROFILE_SYSTEM_BINDING=default

# Infrastructure Account Bindings (Maps Binding Name -> Provider Adapter)
EMAIL_BINDING_DEFAULT_PROVIDER=smtp
# EMAIL_BINDING_INVITATION_PROVIDER=brevo
# EMAIL_BINDING_SECURITY_PROVIDER=smtp
# EMAIL_BINDING_SYSTEM_PROVIDER=brevo

# ------------------------------------------------------------------------------
# 5. Provider Account Credentials (Provider-Specific, Secrets)
# ------------------------------------------------------------------------------
# Generic SMTP Relay (Works with Brevo SMTP, Amazon SES, Postmark, Mailgun)
EMAIL_SMTP_HOST=smtp-relay.brevo.com
EMAIL_SMTP_PORT=587
EMAIL_SMTP_USERNAME=your_smtp_username
EMAIL_SMTP_PASSWORD=your_smtp_password
EMAIL_SMTP_SECURE=false

# Brevo API Credentials & Multi-Account Keys (Optional)
BREVO_API_KEY=xkeysib-your_brevo_default_api_key
# BREVO_API_KEY_INVITATIONS=xkeysib-your_brevo_invitations_key
# BREVO_API_KEY_SECURITY=xkeysib-your_brevo_security_key
# BREVO_API_KEY_SYSTEM=xkeysib-your_brevo_system_key
BREVO_WEBHOOK_SECRET=your_brevo_webhook_secret

# Resend API Credentials (Optional)
RESEND_API_KEY=re_your_resend_api_key
RESEND_WEBHOOK_SECRET=whsec_your_resend_svix_webhook_secret

# ------------------------------------------------------------------------------
# 6. Outbox Worker & Rate Limiting Tuning
# ------------------------------------------------------------------------------
EMAIL_WORKER_INTERVAL_MS=30000
EMAIL_WORKER_BATCH_SIZE=10
EMAIL_WORKER_LEASE_SECONDS=600
EMAIL_MAX_ATTEMPTS=5
EMAIL_RETRY_DELAYS_MS="60000,300000,1800000,3600000"

# ------------------------------------------------------------------------------
# 7. Media & VBrowser Infrastructure (Optional)
# ------------------------------------------------------------------------------
YOUTUBE_API_KEY=your_youtube_api_key
VIRTUAL_BROWSER_ENABLED=false
VIRTUAL_BROWSER_PROVIDER=auto