# ==============================================================================
# CoWatch Production Environment Configuration Matrix
#
# Classification:
# - Required: Application will not start or perform core functions without this.
# - Optional: Feature-specific or fallback capabilities.
# - Secret: Never expose to clients, logs, or public repositories.
# - Public: Injected into client bundle (VITE_*) or safe for client inspection.
# - Provider-Specific: Bound to third-party infrastructure adapters.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Server Core Configuration
# ------------------------------------------------------------------------------
NODE_ENV=production
PORT=8080
HOST=0.0.0.0
APP_URL=https://cowatch.tomesphere.in

# Internal boundary secret for health checks and cluster metrics (Required in Prod)
INTERNAL_API_SECRET=your_high_entropy_internal_secret_token

# Remote standalone email service (use independent high-entropy secrets)
EMAIL_SERVICE_API_SECRET=replace_with_email_service_api_secret
EMAIL_SERVICE_WORKER_SECRET=replace_with_email_service_worker_secret

# ------------------------------------------------------------------------------
# 2. Database & Auth (PostgreSQL via Supabase)
# ------------------------------------------------------------------------------
# PostgreSQL connection string via Supabase IPv4 Connection Pooler (Required for IPv4 hosts like Render)
# Format: postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres (Transaction mode)
# Or:     postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres (Session mode)
DATABASE_URL=postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres

# Backend server service-role credentials (Secret, Required)
SUPABASE_URL=https://[PROJECT_REF].supabase.co
SUPABASE_SECRET_KEY=your_supabase_service_role_secret_key

# Frontend client auth credentials (Public, Required in Vercel/client build)
VITE_SUPABASE_URL=https://[PROJECT_REF].supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your_supabase_anon_public_key
VITE_SERVER_HOST=https://cowatch-api.tomesphere.in

# ------------------------------------------------------------------------------
# 3. Redis Edge & Distributed Coordination (Required in production)
# ------------------------------------------------------------------------------
# REDIS_URL is a development fallback only. Production requires all three dedicated URLs below.
REDIS_URL=rediss://default:[PASSWORD]@[ENDPOINT].upstash.io:6379
REDIS_CORE_URL=rediss://default:[PASSWORD]@[ENDPOINT].upstash.io:6379
REDIS_EDGE_URL=rediss://default:[PASSWORD]@[ENDPOINT].upstash.io:6379
REDIS_METRICS_URL=rediss://default:[PASSWORD]@[ENDPOINT].upstash.io:6379

# ------------------------------------------------------------------------------
# 4. Remote Transactional Email Service
# ------------------------------------------------------------------------------
# Email delivery runs on a separate host. CoWatch never stores provider API keys.
EMAIL_SERVICE_URL=https://email-service.example.com
EMAIL_WORKER_LEASE_SECONDS=600
EMAIL_MAX_ATTEMPTS=5
EMAIL_RETRY_DELAYS_MS="60000,300000,1800000,3600000"

# Provider webhooks remain on CoWatch because delivery/suppression state is stored here.
BREVO_WEBHOOK_SECRET=replace_with_brevo_webhook_secret
RESEND_WEBHOOK_SECRET=replace_with_resend_webhook_secret

# ------------------------------------------------------------------------------
# 7. Media Infrastructure (Optional)
# ------------------------------------------------------------------------------
YOUTUBE_API_KEY=your_youtube_api_key
