NODE_ENV=production
HOST=0.0.0.0
PORT=8090

# HTTPS base URL of the CoWatch API. The email service never connects to PostgreSQL.
HOST_API_URL=https://your-app-api.example.com
# Must match CoWatch EMAIL_SERVICE_WORKER_SECRET.
HOST_API_SECRET=replace_with_a_32_character_or_longer_worker_secret
# Must match CoWatch EMAIL_SERVICE_API_SECRET.
EMAIL_SERVICE_API_SECRET=replace_with_a_different_32_character_or_longer_inbound_secret

EMAIL_WORKER_INTERVAL_MS=15000
EMAIL_WORKER_BATCH_SIZE=10
EMAIL_WORKER_CONCURRENCY=5

APP_URL=https://cowatch.example.com
EMAIL_FROM_NAME=CoWatch

# Four isolated Brevo accounts. Each API key and sender must belong to its matching account.
EMAIL_PROVIDER=brevo

# Default / account emails
EMAIL_PROFILE_DEFAULT_BINDING=default
EMAIL_FROM_ADDRESS=accounts@example.com
BREVO_API_KEY=replace_with_default_brevo_account_api_key

# Invitations
EMAIL_PROFILE_INVITATION_BINDING=invitation
EMAIL_PROFILE_INVITATION_SENDER=invitations@example.com
EMAIL_BINDING_INVITATION_PROVIDER=brevo
BREVO_API_KEY_INVITATIONS=replace_with_invitation_brevo_account_api_key

# Security
EMAIL_PROFILE_SECURITY_BINDING=security
EMAIL_PROFILE_SECURITY_SENDER=security@example.com
EMAIL_BINDING_SECURITY_PROVIDER=brevo
BREVO_API_KEY_SECURITY=replace_with_security_brevo_account_api_key

# System notifications
EMAIL_PROFILE_SYSTEM_BINDING=system
EMAIL_PROFILE_SYSTEM_SENDER=notifications@example.com
EMAIL_BINDING_SYSTEM_PROVIDER=brevo
BREVO_API_KEY_SYSTEM=replace_with_system_brevo_account_api_key

# Optional shared SMTP configuration for profiles explicitly routed to SMTP.
EMAIL_SMTP_HOST=
EMAIL_SMTP_PORT=587
EMAIL_SMTP_USERNAME=
EMAIL_SMTP_PASSWORD=
EMAIL_SMTP_SECURE=false
